{
  "expo": {
    "name": "PU NSS CONNECT",
    "slug": "pu-nss-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_app.png",
    "scheme": "punssconnect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farhankoolimad.PUNSSConnect",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_app.png"
      },
      "package": "com.farhankoolimad.PUNSSConnect",
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo_app.png"
    },
    "plugins": [
      "expo-router",
        [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_app.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/images/logo_app.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PU NSS Connect to access your camera to scan QR codes for event attendance."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aab4fc2c-6891-4e42-a8c3-6207ef8a7683"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/aab4fc2c-6891-4e42-a8c3-6207ef8a7683"
    }
  }
}
